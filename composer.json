{
    "name": "tomatophp/filament-issues",
    "type": "library",
    "description": "Manage your github issues from your FilamentPHP panel and share issues with others",
    "keywords": [
        "php",
        "laravel",
        "github",
        "issues",
        "tracker",
        "filamentphp",
        "filament-plugin"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TomatoPHP\\FilamentIssues\\": "src/",
            "TomatoPHP\\FilamentIssues\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TomatoPHP\\FilamentIssues\\Tests\\": "tests/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TomatoPHP\\FilamentIssues\\FilamentIssuesServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Fady Mondy",
            "email": "info@3x1.io"
        }
    ],
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse src --level=0",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "tomatophp/console-helpers": "^1.1",
        "mallardduck/blade-boxicons": "^2.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "pestphp/pest-plugin-livewire": "^4.0|^5.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "version": "5.0.0"
}
